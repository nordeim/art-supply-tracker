!.env.example

# logs
*.log
dev.log
server.log

# misc
.DS_Store
*.pem
*.tsbuildinfo

# ssh deploy keys — the push wrapper materializes keys outside the repo
*.key
ssh-key.txt
e2e/.auth/
test-results/
playwright-report/
