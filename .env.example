# ---- Database -------------------------------------------------------------
# SQLite by default (zero-config local dev). The `db/` folder lives at the
# repo root, git-ignored. A RELATIVE `file:` URL is resolved against
# prisma/schema.prisma — exactly like the Prisma CLI — so `file:../db/custom.db`
# points at <repo>/db/custom.db for the CLI (migrate/seed), `next build`, and
# the running server alike, regardless of the process working directory.
# (src/lib/db-path.ts implements this resolution; src/lib/db-path.test.ts
# pins the contract.)
# For production, an ABSOLUTE path is still recommended — see
# docs/DEPLOYMENT.md §4.
# To use PostgreSQL:
#   1. Set provider = "postgresql" in prisma/schema.prisma
#   2. Set DATABASE_URL to a PostgreSQL connection string
#   3. bun run db:push && bun run db:seed
DATABASE_URL="file:../db/custom.db"
# Optional escape hatch for exotic deployments (bundled servers where the
# schema directory cannot be located from the module tree): an ABSOLUTE path
# to the directory containing prisma/schema.prisma. Leave UNSET for normal
# dev/build/start — src/lib/db-path.ts resolves the schema directory on its
# own and this variable only overrides it.
# AST_PRISMA_DIR=/absolute/path/to/repo/prisma
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/art_supply_tracker
